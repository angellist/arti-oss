#!/usr/bin/env bash
#
# Pre-push gate for direct pushes to main.
#
# A push to main can trigger a deploy with no human review in between.
# This hook runs the same lint CI runs, plus unit tests, before letting
# a push to main through, so a broken build never reaches deploy.
#
# It only gates pushes whose remote ref is refs/heads/main; everything
# else (feature branches, tags) pushes without delay.
#
# Install: `make hooks` (sets core.hooksPath to .githooks).
# Escape hatch for a genuine emergency: `git push --no-verify`.

set -euo pipefail

protected="refs/heads/main"
gated=0

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one per ref.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	if [ "$remote_ref" = "$protected" ]; then
		gated=1
	fi
done

if [ "$gated" -eq 0 ]; then
	exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-push: pushing to main — running lint + unit tests…"

if ! make lint; then
	echo "pre-push: BLOCKED — 'make lint' failed. Fix it (gofmt -w / go vet) before pushing to main." >&2
	exit 1
fi

if ! make test-unit; then
	echo "pre-push: BLOCKED — 'make test-unit' failed. Don't push a red build to main." >&2
	exit 1
fi

# CI now gates the web tree too (:react: Web Lint & Test). Run the same checks
# here when the deps are already installed, so a frontend change can't sail
# through the hook and fail in CI. Deliberately conditional: someone pushing a
# Go-only change should not be forced to install node_modules — but the skip is
# loud, never silent, so nobody mistakes it for "the web checks passed".
if [ -d web/node_modules ]; then
	if ! make lint-web; then
		echo "pre-push: BLOCKED — 'make lint-web' failed (eslint --max-warnings / tsc). See web/eslint.config.mjs." >&2
		exit 1
	fi
	if ! make test-web; then
		echo "pre-push: BLOCKED — 'make test-web' failed. Don't push a red web suite to main." >&2
		exit 1
	fi
else
	echo "pre-push: NOTE — web checks SKIPPED (no web/node_modules)." >&2
	echo "pre-push:        CI still runs them. If you touched web/, run 'make web-install && make web-check' first." >&2
fi

echo "pre-push: checks passed — pushing to main."
