# arti-server env vars
# Source this file: `set -a && source .env && set +a && ./bin/arti-server serve`

# ── Local dev: skip auth entirely (no Dex / no Google needed) ─────
# When ARTI_AUTH_DISABLED=true, every request is attributed to
# ARTI_LOCAL_EMAIL. Production deployments MUST leave these unset.
# In this mode only, a request may override its identity with the
# `X-Arti-Local-Email` header — handy for emulating a second person
# locally (e.g. testing comment notifications) without restarting.
ARTI_AUTH_DISABLED=true
ARTI_LOCAL_EMAIL=local@example.com

# ── Server addressing ────────────────────────────────────────────
# ARTI_ADDR is where the Go binary listens. ARTI_BASE_URL is the
# canonical hostname stamped into every emitted artifact URL AND the
# default endpoint the CLI hits. For local dev we point both at the
# Next.js dev server on :3031 — Next.js rewrites /api/* + /auth/*
# back to :8095 (see web/next.config.ts), so the user-facing URLs
# always lead to a browser-renderable viewer page.
ARTI_ADDR=:8095
ARTI_BASE_URL=http://localhost:3031

# ── Storage ──────────────────────────────────────────────────────
ARTI_DATABASE_URL=postgres://postgres:postgres@localhost:5436/arti_dev?sslmode=disable

S3_ENDPOINT=http://localhost:9210
S3_BUCKET=arti-dev
S3_USE_SSL=false
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── Auth (when ARTI_AUTH_DISABLED=false) ─────────────────────────
# Prod path: Dex OIDC (matches ace's AUTH_DEX_* pattern). oauth2-proxy
# in front of the pod terminates the user-facing Dex flow and forwards
# the verified JWT in X-Auth-Request-Access-Token; this binary verifies
# it against Dex's JWKS.
# AUTH_DEX_ISSUER_URL=https://id.example.com
# AUTH_JWT_AUDIENCE=auth
# AUTH_REQUIRED_GROUPS=engineers

# Email allowlist. Comma-separated; case-insensitive; the leading "@" is
# optional. Each entry is a bare domain (admits everyone there) or a full
# address (admits exactly that person) — e.g. example.com,you@gmail.com.
# On a consumer IdP use addresses: a bare gmail.com admits every Google
# account. Applied to every auth path (Dex tokens, HS256 test-mode tokens,
# /auth/test issuance).
AUTH_ALLOWED_EMAILS=example.com

# Optional service-to-service shared secret (X-Arti-Service-Secret).
# Use for couch FE proxy or other internal callers that can't yet send
# a Dex token. Stored encrypted in angellist/config/<stack>/env.yaml.
# ARTI_SERVICE_SECRET=

# HS256 key for the test-mode + CLI pair flow. NEVER load a prod
# secret here; this is for `arti login --email` only.
JWT_SIGNING_KEY=dev-key-not-for-prod

# Test-mode token issuer at POST /auth/test. Independent of
# ARTI_AUTH_DISABLED — useful for issuing a token without going
# through the full Dex flow.
ARTI_TEST_MODE=true

# Cookie security flag — must be true behind HTTPS, false for localhost.
ARTI_COOKIE_SECURE=false

# ── Slack comment notifications ──────────────────────────────────
# Bot user OAuth token (xoxb-…) for the "Arti" Slack app. Empty →
# notifications are disabled. Requires bot scopes users:read.email,
# chat:write, im:write. Stored encrypted in angellist/config/<stack>/env.yaml.
# ARTI_SLACK_BOT_TOKEN=

# ── Built-in OIDC login (auth.mode=oidc) ─────────────────────────
# arti runs the authorization-code flow itself against any compliant
# issuer — no fronting SSO proxy needed. Register arti at your IdP with
# redirect URI <ARTI_BASE_URL>/auth/callback. The compose stack ships a
# Dex issuer with a static user (admin@example.com / password) for
# local development of this mode.
# ARTI_AUTH_MODE=oidc
# AUTH_DEX_ISSUER_URL=http://localhost:5556/dex
# AUTH_OIDC_CLIENT_ID=arti
# AUTH_OIDC_CLIENT_SECRET=arti-dev-secret
# AUTH_OIDC_SCOPES=openid,email,profile
# AUTH_OIDC_GROUPS_CLAIM=groups

# ── Embed surfaces (cross-site iframes) ──────────────────────────
# JSON map of named surfaces that serve artifacts into external iframes,
# gated by a per-surface shared secret instead of the SSO cookie. The
# recommended shape is a user-mode surface: the viewer authorizes
# themselves once via a consent popup and tool calls run as the real
# viewer. slug_allow must be an explicit list (never a glob). See
# web/docs/architecture/front-embed.md.
# ARTI_EMBED_SURFACES={"my-surface":{"identity":"user","secret":"<random>","origin":["https://host-app.example.com"],"slug_allow":["my-app"]}}
