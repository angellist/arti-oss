flowchart TB
  req[Incoming request]
  req --> svc{X-Arti-Service-Secret matches?}
  svc -- yes --> ok[Admit as ARTI_SERVICE_EMAIL]
  svc -- no --> tok{Token from Authorization, arti_session cookie, or forwarded access token?}
  tok -- no --> unauth[401 unauthorized]

  tok -- yes --> key{arti_ prefix?}
  key -- yes --> keyrow{Non-revoked, unexpired API key row?}
  keyrow -- no --> unauth
  keyrow -- user key --> gates[Allowlist and groups, not deactivated]
  keyrow -- service key --> sp{Active service principal?}
  sp -- yes --> ok
  sp -- no --> forbid[403 forbidden]

  key -- no --> oidc{OIDC verify -- JWKS}
  oidc -- valid --> gates
  oidc -- not OIDC --> hs{HS256 verify -- session, CLI or device token}
  hs -- invalid --> unauth
  hs -- app-scoped or embed-scoped --> reject[Reject on session routes]
  hs -- valid --> gates
  gates -- pass --> ok
  gates -- fail --> forbid

  ok --> guard{Upload-scoped credential?}
  guard -- yes --> allow[EnforceUploadScope -- create/append/read only, body cap, no /mcp]
  guard -- no --> handler[Handler]
  allow --> handler
