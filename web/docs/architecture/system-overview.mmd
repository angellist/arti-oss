flowchart TB
  cli[arti CLI / headless agent / MCP client]
  browser[Browser]
  iframe[Cross-site iframe or sandboxed APP page]

  subgraph ingress[Ingress]
    prot[ProtectedIngress -- oauth2-proxy plus Dex]
    pub[PublicIngress -- no SSO]
  end

  browser -- web UI, login, /oauth/authorize, /app --> prot
  browser -- /api --> pub
  cli --> pub
  iframe --> pub

  subgraph server[arti-server -- Go]
    authmw[RequireAuth plus EnforceUploadScope]
    rest[REST API -- /api/artifacts]
    mcp[MCP server -- /mcp]
    apps[Apps proxy -- /api/apps/mcp]
    obo[OBO broker]
    embed[Embed surfaces -- /embed]
    devauth[Device + CLI + MCP-OAuth endpoints]
    feproxy[FE reverse proxy]
  end

  pub --> authmw
  authmw --> rest
  authmw --> mcp
  pub --> apps
  pub --> embed
  pub --> devauth
  prot --> feproxy

  web[Web sidecar -- Next.js]
  feproxy --> web

  pg[(Postgres -- metadata)]
  s3[(S3 / RustFS -- bytes)]
  gateway[Upstream MCP servers / gateway]

  rest --> pg
  rest --> s3
  mcp --> pg
  apps --> pg
  apps --> obo
  obo --> gateway
  embed --> s3
  devauth --> pg
