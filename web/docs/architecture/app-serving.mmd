flowchart TD
    page["Sandboxed APP page<br/>(opaque origin, no cookie)<br/>window.arti.callTool(server, tool, args)"]
    proxy["apps proxy — POST /api/apps/mcp<br/>(public group, Bearer + CORS)<br/>1 verify app token (scope app:&lt;id&gt;)<br/>2 re-check domain allowlist<br/>3 match app_id to token<br/>4 load APP, re-check read access<br/>5 enforce arti-app.json allowlist"]
    inproc["arti's own tools<br/>(read, write, comments, map_*)<br/>run in-process as the viewer"]
    conn["resolve connector<br/>(app_mcp_servers row:<br/>enabled? tool allowed?)"]
    llm["llm completer<br/>(Auth: service, in-process,<br/>per-viewer budgets)"]
    obo["OBO broker (internal/obo)<br/>per-user upstream Bearer"]
    mcp["mcpclient → tools/call<br/>(timeout, _meta.consumer)"]
    upstream["Upstream MCP server"]

    page -->|"Bearer app token, credentials:omit"| proxy
    proxy -->|"server arti / arti-self"| inproc
    proxy --> conn
    proxy -->|"server llm"| llm
    conn -->|"Auth: oauth → BearerFor"| obo
    obo -->|"401 + authorize_url if no token"| page
    conn -->|"Auth: none"| mcp
    obo --> mcp
    mcp --> upstream
    upstream -->|"result JSON"| page
    inproc -->|"result JSON"| page
